{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/review",
      "destination": "/hod/",
      "permanent": false
    },
    {
      "source": "/review/",
      "destination": "/hod/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hod/",
      "destination": "/index.html"
    },
    {
      "source": "/play/",
      "destination": "/index.html"
    },
    {
      "source": "/profile/",
      "destination": "/index.html"
    }
  ]
}
