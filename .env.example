# Online saving (optional). Copy this file to .env.local for local development, and set the same two
# variables in Vercel: Project > Settings > Environment Variables (Production and Preview), then redeploy.
# Vite bakes them in at build time, so changing them needs a new build.
#
# Use the PUBLIC key only: "Publishable key" (sb_publishable_...) or the older "anon" key, from
# Supabase dashboard > Project Settings > API Keys.
# NEVER use the "secret" key (sb_secret_...) or the "service_role" key here: they would be published in the page.
# (The site refuses to start online saving if it detects one.)
VITE_SUPABASE_URL=https://uvtifolnsneitetzohtn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
